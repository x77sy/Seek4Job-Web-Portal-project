}

// Save account settings 
const accountEmailInput = document.getElementById('accountEmail');
const accountPhoneInput = document.getElementById('accountPhone');
const notifyApplicants = document.getElementById('notifyApplicants');
const notifyMessages = document.getElementById('notifyMessages');
const notifySystem = document.getElementById('notifySystem');
const saveSettingsBtn = document.getElementById('saveSettingsBtn');

if (saveSettingsBtn) {
  saveSettingsBtn.addEventListener('click', () => {
    const settings = {
      email: accountEmailInput.value,
      phone: accountPhoneInput.value,
      notifyApplicants: notifyApplicants.checked,
      notifyMessages: notifyMessages.checked,
      notifySystem: notifySystem.checked
    };

    localStorage.setItem("accountSettings", JSON.stringify(settings));
    alert("Account settings saved successfully!");

    if (accountEmailInput.value) {
      accountEmailInput.placeholder = accountEmailInput.value;
      accountEmailInput.value = "";
    }
    if (accountPhoneInput.value) {
      accountPhoneInput.placeholder = accountPhoneInput.value;
      accountPhoneInput.value = "";
    }
  });
}

// Save account passowrd
const newPasswordInput = document.getElementById('newPassword');
const confirmPasswordInput = document.getElementById('confirmPassword');
const savePasswordBtn = document.getElementById('savePasswordBtn');

if (savePasswordBtn) {
  savePasswordBtn.addEventListener('click', () => {
    const pass1 = newPasswordInput.value;
    const pass2 = confirmPasswordInput.value;

    if (!pass1 || !pass2) {
      alert("Please fill in both password fields.");
      return;
    }
    if (pass1 !== pass2) {
      alert("Passwords do not match.");
      return;
    }
    if (pass1.length < 6) {
      alert("Password should be at least 6 characters.");
      return;
    }

    localStorage.setItem("accountPassword", pass1);
    alert("Password updated successfully!");

    newPasswordInput.value = "";
    confirmPasswordInput.value = "";
  });
}

// Load saved data 
window.addEventListener('load', () => {
  const savedLogo = localStorage.getItem("companyLogo");
  if (savedLogo) {
    logoBox.style.backgroundImage = `url(${savedLogo})`;
    logoBox.style.backgroundSize = "cover";
    logoBox.style.backgroundPosition = "center";
    logoBox.textContent = "";
  }

  const savedCompany = JSON.parse(localStorage.getItem("companyInfo") || "null");
  if (savedCompany) {
    companyInputs.forEach(field => {
      const label = field.previousElementSibling?.textContent;
      if (!label) return;
      const savedVal = savedCompany[label];
      if (!savedVal) return;

      if (field.tagName === "SELECT") {
        field.value = savedVal;
      } else if (field.tagName === "TEXTAREA" || field.type === "text") {
        field.placeholder = savedVal;
      }
    });

    if (industrySelect && sizeSelect && companySummary) {
      const industry = savedCompany["Industry / Sector"] || industrySelect.value;
      const size = savedCompany["Company Size"] || sizeSelect.value;
      companySummary.textContent = `${industry} | ${size}`;
    }
  }

  const savedRecruit = JSON.parse(localStorage.getItem("recruitPrefs") || "null");
  if (savedRecruit) {
    recruitInputs.forEach(field => {
      const label = field.previousElementSibling?.textContent;
      if (!label) return;
      const savedVal = savedRecruit[label];
      if (!savedVal) return;

      if (field.tagName === "SELECT") {
        field.value = savedVal;
      } else {
        field.placeholder = savedVal;
      }
    });
  }

  const savedSettings = JSON.parse(localStorage.getItem("accountSettings") || "null");
  if (savedSettings) {
    if (savedSettings.email) {
      accountEmailInput.placeholder = savedSettings.email;
    }
    if (savedSettings.phone) {
      accountPhoneInput.placeholder = savedSettings.phone;
    }
    notifyApplicants.checked = !!savedSettings.notifyApplicants;
    notifyMessages.checked = !!savedSettings.notifyMessages;
    notifySystem.checked = !!savedSettings.notifySystem;
  }
});

