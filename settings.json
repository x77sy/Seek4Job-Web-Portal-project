// Badges tab (Search and sorting)

// Convert "Issued on DD/MM/YYYY" to timestamp
function parseBadgeDate(text) {
  if (!text) return 0;

  const raw = text.replace("Issued on", "").trim();
  const parts = raw.split("/");

  if (parts.length !== 3) return 0;

  const day = parseInt(parts[0], 10);
  const month = parseInt(parts[1], 10);
  const year = parseInt(parts[2], 10);

  if (isNaN(day) || isNaN(month) || isNaN(year)) return 0;

  return new Date(year, month - 1, day).getTime();
}

function initBadgeSearchSort() {
  const searchInput = document.getElementById("badgeSearch");
  const searchBtn = document.getElementById("badgeSearchBtn");
  const sortInput = document.getElementById("badgeSort");
  const grid = document.getElementById("badgeGrid");

  // Check if elements exist
  if (!searchInput || !searchBtn || !sortInput || !grid) {
    console.warn("Badge search or sort elements not found.");
    return;
  }

  // Store original cards
  const cards = Array.from(grid.querySelectorAll(".badge-card"));
  if (cards.length === 0) return;

  function updateBadges() {
    let filtered = [...cards];

    const searchText = searchInput.value.toLowerCase().trim();
    const sortValue = sortInput.value;

    // Search by card text
    if (searchText) {
      filtered = filtered.filter(card =>
        card.innerText.toLowerCase().includes(searchText)
      );
    }

    // Sort by name
    if (sortValue === "name") {
      filtered.sort((a, b) => {
        const nameA = a.querySelector(".badge-title")?.innerText || "";
        const nameB = b.querySelector(".badge-title")?.innerText || "";
        return nameA.localeCompare(nameB);
      });
    }

    // Sort by date
    if (sortValue === "date") {
      filtered.sort((a, b) => {
        const dateTextA = a.querySelector(".badge-date")?.innerText || "";
        const dateTextB = b.querySelector(".badge-date")?.innerText || "";

        const da = parseBadgeDate(dateTextA);
        const db = parseBadgeDate(dateTextB);

        return db - da;
      });
    }

    // Render updated cards
    grid.innerHTML = "";
    filtered.forEach(card => grid.appendChild(card));
  }

  // Event listeners
  sortInput.addEventListener("change", updateBadges);
  searchBtn.addEventListener("click", updateBadges);

  console.log("Badge search and sort initialized.");
}

// Auto init when badge grid exists
document.addEventListener("DOMContentLoaded", () => {
  if (document.getElementById("badgeGrid")) {
    initBadgeSearchSort();
  }
});

// Function to handle the form submission
function reviewApplication(event) {
    event.preventDefault(); // Stop page reload

    // Get values from the form inputs
    const name = document.getElementById("appName").value;
    const email = document.getElementById("appEmail").value;
    const phone = document.getElementById("appPhone").value;
    const salary = document.getElementById("appSalary").value;
    const intro = document.getElementById("appIntro").value;
    
    // Get Chip Selections
    // This looks for chips that have the class 'active' inside specific groups
    const availability = document.querySelector('.work-group .chip.active')?.innerText || "Not selected";
    
    // Benefits allows multiple, so we map them to an array
    const benefitsList = Array.from(document.querySelectorAll('.benefits-group .chip.active'))
                              .map(chip => chip.innerText)
                              .join(", ");

    // Build the Review HTML
    const reviewHTML = `
        <div class="review-item"><strong>Full Name:</strong> ${name}</div>
        <div class="review-item"><strong>Email:</strong> ${email}</div>
        <div class="review-item"><strong>Phone:</strong> ${phone}</div>
        <div class="review-item"><strong>Expected Salary:</strong> RM ${salary}</div>
        <div class="review-item"><strong>Availability:</strong> ${availability}</div>
        <div class="review-item"><strong>Expected Benefits:</strong> ${benefitsList || "None selected"}</div>
        <div class="review-item"><strong>Introduction:</strong> <br>${intro}</div>
    `;

    // Inject content and show modal
    document.getElementById("reviewContent").innerHTML = reviewHTML;
    document.getElementById("reviewModal").style.display = "flex";
}

// Final Submit Action
function finalSubmitApplication() {
    closeReview();
    alert("Application submitted successfully! Good luck.");
    // Redirect to dashboard or view applied jobs
    window.location.href = "view_applied_jobs.html";
}

// Chip Selection Logic (Toggle 'active' class)
document.addEventListener("DOMContentLoaded", () => {
    const chips = document.querySelectorAll(".chip");
    chips.forEach(chip => {
        chip.addEventListener("click", () => {
            // If it's the work group (single select), remove active from others
            if (chip.parentElement.classList.contains('work-group')) {
                chip.parentElement.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
                chip.classList.add('active');
            } else {
                // Benefits group (multi select)
                chip.classList.toggle("active");
            }
        });
    });
});

// delete the posted job
function deleteJob(id, btn) {
    const row = btn.closest("tr");

    if (!confirm("Are you sure you want to delete this job?")) return;

    if (!isNaN(id)) {
        let jobs = JSON.parse(localStorage.getItem("postedJobs") || "[]");
        jobs.splice(id, 1);
        localStorage.setItem("postedJobs", JSON.stringify(jobs));
    }

    row.remove();
}