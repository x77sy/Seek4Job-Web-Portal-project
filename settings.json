document.getElementById('companyTab').style.display = 'block';

// Logo update and remove
const upload = document.getElementById('logoUpload');
const logoBox = document.getElementById('companyLogo');

if (upload) {
  upload.addEventListener('change', function () {
    const file = upload.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = () => {
        logoBox.style.backgroundImage = `url(${reader.result})`;
        logoBox.style.backgroundSize = "cover";
        logoBox.style.backgroundPosition = "center";
        logoBox.textContent = "";
        localStorage.setItem("companyLogo", reader.result);
      };
      reader.readAsDataURL(file);
    }
  });
}

function removeLogo() {
  logoBox.style.backgroundImage = "none";
  logoBox.textContent = "Logo";
  localStorage.removeItem("companyLogo");
}

// Save company details
const companyInputs = document.querySelectorAll(
  '#companyTab input, #companyTab select, #companyTab textarea'
);
const saveCompanyBtn = document.getElementById('saveCompanyBtn');
const companySummary = document.getElementById('companySummary');
const industrySelect = document.getElementById('companyIndustry');
const sizeSelect = document.getElementById('companySize');

if (saveCompanyBtn) {
  saveCompanyBtn.addEventListener('click', () => {
    const companyData = {};

    companyInputs.forEach(field => {
      const label = field.previousElementSibling?.textContent;
      if (!label) return;
      companyData[label] = field.value;
    });

    localStorage.setItem("companyInfo", JSON.stringify(companyData));
    alert("Company details saved successfully!");

    if (industrySelect && sizeSelect && companySummary) {
      const industry = industrySelect.value || "Industry";
      const size = sizeSelect.value || "Company size";
      companySummary.textContent = `${industry} | ${size}`;
    }

    companyInputs.forEach(field => {
      if (field.tagName === "SELECT") return;
      field.placeholder = field.value || field.placeholder;
      field.value = "";
    });
  });
}

// Save recruitment preferences
const recruitInputs = document.querySelectorAll(
  '#recruitTab input, #recruitTab select, #recruitTab textarea'
);
const saveRecruitBtn = document.getElementById('saveRecruitBtn');

if (saveRecruitBtn) {
