// Search and filter features
document.addEventListener("DOMContentLoaded", () => {

    // Detect which page we are on
    const isApplicantsPage = document.querySelector(".applicant-link") !== null;
    const isPostedJobsPage = document.querySelector(".posted-job-title") !== null;

    // Common elements
    const searchInput = document.getElementById("searchInput");
    const searchBtn = document.getElementById("searchBtn");
    const statusFilter = document.getElementById("statusFilter");
    const sortFilter = document.getElementById("sortFilter");

    // Page-specific filters
    const jobFilter = document.getElementById("jobFilter"); 
    const typeFilter = document.getElementById("typeFilter");
    const locationFilter = document.getElementById("locationFilter");

    const tableBody = document.querySelector("tbody");
    const rows = [...tableBody.querySelectorAll("tr")];

    // --- Helper: safe date parser for "22 Nov 2023" or "-" ---
    function parseDate(text) {
        if (!text) return 0;
        const str = text.trim();
        if (str === "-" || str === "") return 0;

        // Expected format: "22 Nov 2023"
        const parts = str.split(" ");
        if (parts.length !== 3) {
            // Fallback to Date() if unexpected format
            const d = new Date(str);
            return isNaN(d.getTime()) ? 0 : d.getTime();
        }

        const [dayStr, monStr, yearStr] = parts;
        const day = parseInt(dayStr, 10);
        const year = parseInt(yearStr, 10);

        const months = {
            jan: 0, feb: 1, mar: 2, apr: 3, may: 4, jun: 5,
            jul: 6, aug: 7, sep: 8, oct: 9, nov: 10, dec: 11
        };

        const m = months[monStr.toLowerCase()];
        if (m === undefined || isNaN(day) || isNaN(year)) {
            const d = new Date(str);
            return isNaN(d.getTime()) ? 0 : d.getTime();
        }

        return new Date(year, m, day).getTime();
    }

    // Main update function
    function updateTable() {
        // Always start from original rows
        let filtered = [...rows];

        const searchText = searchInput?.value.toLowerCase().trim() || "";
        const selectedJob = jobFilter?.value.toLowerCase() || "";
        const selectedStatus = statusFilter?.value.toLowerCase() || "";
        const selectedType = typeFilter?.value.toLowerCase() || "";
        const selectedLocation = locationFilter?.value.toLowerCase() || "";
        const sortOption = sortFilter?.value || "";

        // 🔍 Search (common)
        if (searchText) {
            filtered = filtered.filter(row =>
                row.innerText.toLowerCase().includes(searchText)
            );
        }

        // 🧑‍💼 Applicants Page Filters
        if (isApplicantsPage) {

            // Job filter
            if (selectedJob) {
                filtered = filtered.filter(row => {
                    const job = row.querySelector(".job-subtitle")?.innerText.toLowerCase();
                    return job === selectedJob;
                });
            }

            // Status filter
            if (selectedStatus) {
                filtered = filtered.filter(row => {
                    const status = row.querySelector(".status")?.innerText.toLowerCase();
                    return status === selectedStatus;
                });
            }

            // Sort by applied date (col index 3)
            filtered.sort((a, b) => {
                const dateA = parseDate(a.children[3].innerText);
                const dateB = parseDate(b.children[3].innerText);

                if (sortOption === "latest") return dateB - dateA;
                if (sortOption === "oldest") return dateA - dateB;
                return 0;
            });
        }

        // 📄 Posted Job Page Filters
        if (isPostedJobsPage) {

            // Type
            if (selectedType) {
                filtered = filtered.filter(row => {
                    const subtitle = row.querySelector(".job-subtitle")?.innerText.toLowerCase();
                    return subtitle.includes(selectedType);
                });
            }

            // Status
            if (selectedStatus) {
                filtered = filtered.filter(row => {
                    const status = row.querySelector(".status")?.innerText.toLowerCase();
                    return status === selectedStatus;
                });
            }

            // Location
            if (selectedLocation) {
                filtered = filtered.filter(row => {
                    const subtitle = row.querySelector(".job-subtitle")?.innerText.toLowerCase();
                    return subtitle.includes(selectedLocation);
                });
            }

            // Sorting
            filtered.sort((a, b) => {
                const dateA = parseDate(a.children[2].innerText); // "Date Posted" col
                const dateB = parseDate(b.children[2].innerText);

                const applicantsA = parseInt(a.children[3].innerText) || 0;
                const applicantsB = parseInt(b.children[3].innerText) || 0;

                switch (sortOption) {
                    case "latest": 
                        return dateB - dateA;
                    case "oldest": 
                        return dateA - dateB;
                    case "high": 
                        return applicantsB - applicantsA;
                    case "low": 
                        return applicantsA - applicantsB;
                    default: 
                        return 0;
                }
            });
        }

        // Render updated rows
        tableBody.innerHTML = "";
        filtered.forEach(row => tableBody.appendChild(row));
    }

    // Safe listener wrapper
    const addListener = (el, event) => {
        if (el) el.addEventListener(event, updateTable);
    };

    // Attach events
    addListener(searchBtn, "click");
    addListener(searchInput, "input");
    addListener(jobFilter, "change");
    addListener(statusFilter, "change");
    addListener(typeFilter, "change");
    addListener(locationFilter, "change");
    addListener(sortFilter, "change");
});

// Tab Switching
function openTab(evt, tabId) {
  document.querySelectorAll('.tab-content').forEach(t => t.style.display = 'none');
  document.getElementById(tabId).style.display = 'block';

  document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
  evt.target.classList.add('active');
}

