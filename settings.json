// Review posted job details
function openReview() {

  // Get values from form
  let jobTitle = document.querySelector('input[placeholder="Full Stack Developer"]').value;
  let location = document.querySelectorAll('select')[0].value;
  let reside = document.querySelector('input[name="reside"]:checked').parentNode.innerText.trim();
  let description = document.querySelector("textarea").value;

  // Get values selections by group
  let jobTypes = [...document.querySelectorAll('.job-type-group .chip.active')].map(x => x.innerText);
  let schedule = [...document.querySelectorAll('.schedule-group .chip.active')].map(x => x.innerText);
  let supplemental = [...document.querySelectorAll('.supplemental-group .chip.active')].map(x => x.innerText);
  let benefits = [...document.querySelectorAll('.benefits-group .chip.active')].map(x => x.innerText);

  // Select inputs
  let showPayBy = document.querySelectorAll('select')[1].value;
  let rate = document.querySelectorAll('select')[2].value;

  // Pay range
  let minPay = document.querySelectorAll('input[type="number"]')[0].value;
  let maxPay = document.querySelectorAll('input[type="number"]')[1].value;

  // Dropdown fields
  let hires = document.querySelectorAll('select')[3].value;
  let urgency = document.querySelectorAll('select')[4].value;

  // Build Review Content
  let reviewHTML = `
    <div class="review-item"><strong>Job Title</strong>${jobTitle}</div>
    <div class="review-item"><strong>Location Type</strong>${location}</div>
    <div class="review-item"><strong>Reside Requirement</strong>${reside}</div>
    <div class="review-item"><strong>Job Type</strong>${jobTypes.join(", ")}</div>
    <div class="review-item"><strong>Schedule</strong>${schedule.join(", ")}</div>
    <div class="review-item"><strong>Pay Range</strong>${minPay} - ${maxPay} (${rate})</div>
    <div class="review-item"><strong>Supplemental Pay</strong>${supplemental.join(", ")}</div>
    <div class="review-item"><strong>Benefits</strong>${benefits.join(", ")}</div>
    <div class="review-item"><strong>Number of hires</strong>${hires}</div>
    <div class="review-item"><strong>Hiring urgency</strong>${urgency}</div>
    <div class="review-item"><strong>Job Description</strong>${description}</div>
  `;

  document.getElementById("reviewContent").innerHTML = reviewHTML;

  // Show popup
  document.getElementById("reviewModal").style.display = "flex";
}

// Avoid has empty field
function validateAndReview(event) {
    event.preventDefault(); // stop real submission

    const form = document.getElementById("jobForm");

    // Show built-in required validation
    if (!form.checkValidity()) {
        form.reportValidity(); 
        return false; 
    }

    // If all required fields filled then show review details page
    openReview();
    return false;
}

// Close review details page
function closeReview() {
  document.getElementById("reviewModal").style.display = "none";
}

// Final submit
function finalSubmit() {
  closeReview();
  alert("Job successfully submitted!");

  // Redirect after submission
  window.location.href = "view_posted_job.html";
}

