<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Seek4Job</title>
  <link rel="stylesheet" href="CSS/style.css">
</head>

<body class="signin-body">
    <h1 class="signin-h1">Welcome to Seek4Job!</h1>
    <img src="images/logo.png" alt="Logo" class="logo1-img">
    <h1 class="signin-h1">Sign In</h1>
    <p class="signin-p">Don't have an account?
        <a href="signup.html" class="register-link">Register</a>
    </p>

    <form id="signinForm" class="signin_signup-form">
        <input type="email" id="email" name="email" placeholder="Email" required>

        <input type="password" id="password" name="password" placeholder="Password" required>
        <a href="forgetpassword.html" class="forgetpassword-link">Forgot your password?</a>

        <button type="submit" class="signin-btn">Sign In</button>
    </form>
    <script src="JS/main.js"></script>
</body>

</html>